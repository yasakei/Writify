{
  "manifest_version": 2,
  "name": "Writify",
  "version": "1.0",
  "description": "A browser extension that fixes your grammar using Gemini API when Ctrl+Shift+F is pressed.",
  "permissions": [
    "activeTab",
    "<all_urls>",
    "http://localhost:3000/"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {}
}
